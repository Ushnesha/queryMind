        "Student_Enrolment.degree_program_id",
        "Student_Enrolment.student_id",
        "Students.first_name",
        "Students.last_name",
        "Students.middle_name",
        "Students.student_id"
      ],
      "required_joins": [
        {
          "from_table": "Student_Enrolment",
